# HERMES_Quantum Environment Configuration
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control!

# =============================================================================
# REDDIT API (FREE - Required for Agent 23 Social Sentiment)
# Register at: https://www.reddit.com/prefs/apps
# Create a "script" type application
# =============================================================================
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=HERMES_Quantum/1.0 (by u/YourUsername)

# =============================================================================
# STOCKTWITS API (FREE - Required for Agent 23 Social Sentiment)
# Register at: https://stocktwits.com/developers/apps/new
# =============================================================================
STOCKTWITS_ACCESS_TOKEN=your_access_token_here

# =============================================================================
# FINNHUB.IO (FREE TIER - Optional, 60 calls/min)
# Register at: https://finnhub.io/register
# =============================================================================
FINNHUB_API_KEY=your_finnhub_key_here

# =============================================================================
# FRED (FREE - Optional, for macro/economic data)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
# =============================================================================
FRED_API_KEY=your_api_key_here

# =============================================================================
# ALPHA VANTAGE (FREE TIER - Optional, 25 requests/day)
# Register at: https://www.alphavantage.co/support/#api-key
# =============================================================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# =============================================================================
# SEC EDGAR (FREE - No key needed, just User-Agent)
# =============================================================================
SEC_USER_AGENT=HERMES_Quantum/1.0 (your-email@example.com)

# =============================================================================
# HUGGING FACE (Optional - for private/gated models)
# Get token at: https://huggingface.co/settings/tokens
# =============================================================================
HF_TOKEN=your_token_here

# =============================================================================
# WEIGHTS & BIASES (Optional - for experiment tracking)
# Register at: https://wandb.ai/authorize
# =============================================================================
WANDB_API_KEY=your_api_key_here

# =============================================================================
# DATABASE (Local SQLite - no external DB needed for Phase 1)
# =============================================================================
DATABASE_PATH=outputs/data/hermes.db

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_PATH=outputs/logs/

# =============================================================================
# MODEL CACHE (Local storage for downloaded models)
# =============================================================================
MODEL_CACHE_DIR=outputs/models/

# =============================================================================
# QUANTUM STOCK TICKERS (Our focus stocks)
# =============================================================================
QUANTUM_TICKERS=QBTS,IONQ,RGTI,QUBT

# =============================================================================
# DEPRECATED - SKIPPED (too expensive, use free alternatives above)
# =============================================================================
# TWITTER_API_KEY - SKIP: $100/month for 333 posts/day (use Reddit + StockTwits instead)
# POLYGON_API_KEY - SKIP: $199/month (yfinance is free)
# NEWS_API_KEY - SKIP: $449/month (use RSS feeds instead)

